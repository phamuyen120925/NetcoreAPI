@model MVC.Models.Product

<h2>Thêm sản phẩm</h2>

<form asp-action="Create">

    <div>
        <label>Mã SP</label>
        <input asp-for="ProductID" />
    </div>

    <div>
        <label>Tên SP</label>
        <input asp-for="ProductName" />
    </div>

    <div>
        <label>Giá</label>
        <input asp-for="Price" />
    </div>

    <button type="submit">Lưu</button>

</form>