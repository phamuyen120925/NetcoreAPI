@model IEnumerable<MVC.Models.Order>

<h2>Danh sách đơn hàng</h2>

<p>
    <a asp-action="Create">Thêm đơn hàng</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Mã đơn hàng</th>
            <th>Ngày đặt</th>
            <th>Khách hàng</th>
        </tr>
    </thead>

    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.OrderID</td>
                <td>@item.OrderDate</td>
                <td>@item.Customer?.FullName</td>
            </tr>
        }
    </tbody>
</table>
