@model MVC.Models.OrderDetail

<h2>Thêm chi tiết đơn hàng</h2>

<form asp-action="Create">

    <div>
        <label>Đơn hàng</label>

        <select asp-for="OrderID"
                asp-items="ViewBag.OrderID">
        </select>
    </div>

    <br />

    <div>
        <label>Sản phẩm</label>

        <select asp-for="ProductID"
                asp-items="ViewBag.ProductID">
        </select>
    </div>

    <br />

    <div>
        <label>Số lượng</label>
        <input asp-for="Quantity" />
    </div>

    <br />

    <button type="submit">
        Lưu
    </button>

</form>